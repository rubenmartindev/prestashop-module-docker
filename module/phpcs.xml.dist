<?xml version="1.0"?>
<ruleset name="RubenMartinDev\Module\MyModule" namespace="RubenMartinDevMyModule">

    <config name="testVersion" value="5.6-" />
    <config name="installed_paths" value="/app/tooling/vendor/phpcompatibility/php-compatibility" />

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="colors" />
    <arg name="extensions" value="php" />
    <arg value="p" />

    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>mymodule.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>mymodule.php</exclude-pattern>
    </rule>

    <rule ref="PSR12">
        <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock" />
    </rule>

    <rule ref="PHPCompatibility" />

</ruleset>

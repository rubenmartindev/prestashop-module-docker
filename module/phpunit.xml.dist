<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/5.7/phpunit.xsd"
    backupGlobals="false"
    colors="true"
    failOnDeprecation="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>

        <testsuite name="Tests">
        <directory>tests</directory>
        </testsuite>

    </testsuites>
</phpunit>
